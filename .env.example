# 반드시 학교 배포 전에 변경. 이미 .env가 있으면 덮어쓰지 마세요.
# 배포 검사: SECRET_KEY는 예제 값이 아닌 무작위 32자 이상
SECRET_KEY=change-me
# 두 아이디는 서로 다르게, 두 비밀번호는 각각 예제 값이 아닌 12자 이상
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=developer1234
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher1234
# 개발자 화면에 표시할 오류 로그 설정
ERROR_LOG_PATH=instance/errors.log
ERROR_LOG_MAX_BYTES=1000000
ERROR_LOG_BACKUP_COUNT=2
ERROR_LOG_DISPLAY_BYTES=65536
# true이면 최종 대여·반납 처리 전에 PIN 확인 (배포용 serve.py는 true 필수)
STATION_AUTH_REQUIRED=true
# STATION_AUTH_REQUIRED=false이면 아래 PIN을 확인하지 않음
STATION_PIN=1234
# 배포 시 PIN은 같은 숫자 반복을 피한 6~12자리 숫자로 변경

# 비워 두면 프로젝트의 instance/equipment.db 사용
# DATABASE=/opt/equipment-manager/instance/equipment.db

# 개발 단계: mock / 실제 카메라: yolo. serve.py는 기본적으로 yolo를 요구합니다.
# 모델 없는 웹 확인만 할 때: python serve.py --allow-mock
DETECTOR_MODE=mock
YOLO_MODEL_PATH=models/best.pt
YOLO_IMAGE_SIZE=320
YOLO_CONFIDENCE=0.60
YOLO_MIN_VOTES=3
YOLO_FRAME_COUNT=5
YOLO_MAX_DETECTIONS=5
INFERENCE_THREADS=2
GC_INTERVAL_SCANS=20

# 모델 클래스명과 DB의 한글 기자재명이 다를 때 JSON으로 연결
# 예: {"multimeter":"멀티미터","arduino":"아두이노"}
YOLO_CLASS_ALIASES='{}'

# Raspberry Pi 카메라: picamera2 / USB 카메라: opencv
CAMERA_BACKEND=picamera2
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_BUFFER_COUNT=2
CAMERA_WARMUP_SECONDS=0.5

DEFAULT_EQUIPMENT=멀티미터,아두이노,브레드보드
DEFAULT_QUANTITY=10
# 새 기자재의 기본 기간과 관리자가 지정할 수 있는 최대 기간
DEFAULT_LOAN_DAYS=7
MAX_LOAN_DAYS=90
DEVICE_NAME=실습실 기자재 인식 스테이션
MEMORY_WARNING_MB=1200

# GPIO를 연결한 뒤 true로 변경
GPIO_ENABLED=false
GPIO_GREEN_PIN=17
GPIO_RED_PIN=27
GPIO_BUZZER_PIN=22

HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=15
DEVICE_OFFLINE_SECONDS=45
SESSION_COOKIE_SECURE=false
# HTTP에서는 false 유지. HTTPS를 구성한 뒤에만 true로 변경.
