# 반드시 학교 배포 전에 변경
SECRET_KEY=change-me
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=developer1234
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher1234
# false이면 대여·반납 화면을 로그인 없이 사용
STATION_AUTH_REQUIRED=false
# STATION_AUTH_REQUIRED=true일 때만 사용
STATION_PIN=1234

# 비워 두면 프로젝트의 instance/equipment.db 사용
# DATABASE=/opt/equipment-manager/instance/equipment.db

# 개발 단계: mock / 실제 카메라: yolo
DETECTOR_MODE=mock
YOLO_MODEL_PATH=models/best.pt
YOLO_IMAGE_SIZE=320
YOLO_CONFIDENCE=0.60
YOLO_MIN_VOTES=3
YOLO_FRAME_COUNT=5
YOLO_MAX_DETECTIONS=5
INFERENCE_THREADS=2
GC_INTERVAL_SCANS=20

# 모델 클래스명과 DB의 한글 기자재명이 다를 때 JSON으로 연결
# 예: {"multimeter":"멀티미터","arduino":"아두이노"}
YOLO_CLASS_ALIASES='{}'

# Raspberry Pi 카메라: picamera2 / USB 카메라: opencv
CAMERA_BACKEND=picamera2
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_BUFFER_COUNT=2
CAMERA_WARMUP_SECONDS=0.5

DEFAULT_EQUIPMENT=멀티미터,아두이노,브레드보드
DEFAULT_QUANTITY=10
# 새 기자재의 기본 기간과 관리자가 지정할 수 있는 최대 기간
DEFAULT_LOAN_DAYS=7
MAX_LOAN_DAYS=90
DEVICE_NAME=실습실 기자재 인식 스테이션
MEMORY_WARNING_MB=1200

# GPIO를 연결한 뒤 true로 변경
GPIO_ENABLED=false
GPIO_GREEN_PIN=17
GPIO_RED_PIN=27
GPIO_BUZZER_PIN=22

HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=15
DEVICE_OFFLINE_SECONDS=45
SESSION_COOKIE_SECURE=false
