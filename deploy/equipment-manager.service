[Unit]
Description=AI Equipment Manager Web Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
# serve.py reads and validates the project's .env without modifying it.
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=POWER_OFF_ENABLED=__POWER_OFF__
Environment=SYSTEMD_SERVICE_MANAGED=true
ExecStart=:__PYTHON__ __SERVER__ __MODE_ARGS__
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
MemoryHigh=1300M
MemoryMax=1600M
TasksMax=64
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
