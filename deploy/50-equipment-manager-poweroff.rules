// Allow only starting the two fixed, root-owned timers; no arbitrary units.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") === "equipment-manager-poweroff.timer" ||
         action.lookup("unit") === "equipment-manager-stop.timer") &&
        action.lookup("verb") === "start" &&
        subject.user === "__USER__") {
        return polkit.Result.YES;
    }
});
